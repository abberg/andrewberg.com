---
import HeroCard from '../parts/HeroCard.astro';
import Note from '../parts/Note.astro';
import Row from '../parts/Row.astro';
import Swatches from '../parts/Swatches.astro';
import Shapes from '../parts/Shapes.astro';
import Shadows from '../parts/Shadows.astro';
import Button from '../parts/Button.astro';

// Ascent, Klaviyo. Colours come from Klaviyo's own --color-* and --elevation-* variables, set once on the root below.
const usage = [
  ['Button', '2,418', 100], ['Text', '2,105', 87], ['Card', '1,307', 54], ['Select', '964', 40], ['Badge', '812', 34], ['Modal', '455', 19], ['Table', '390', 16],
];
const props = [
  ['variant', [['primary', 34, '#1D1E20'], ['secondary', 48, '#C4C9CF'], ['tertiary', 18, '#EAEDEF']]],
  ['size', [['md', 71, '#155FEA'], ['sm', 22, '#397EE5'], ['lg', 7, '#C2D6FA']]],
];
const tokens = [['#1D1E20', '1.2k'], ['#155FEA', '640'], ['#F3F6F7', '410'], ['#C4C9CF', '388'], ['#25935C', '96']];
const flows = [
  ['Abandoned Cart', 'Checkout Started'],
  ['Email Welcome Series', 'Added to Email List list'],
  ['Welcome Series - Customer v. Non-Customer', 'Added to Exclusive Discounts list'],
];
---
<div class="ascent">
  <HeroCard label="Usage explorer" col={2} row={2}>
    <div class="ux">
      <div class="ux-top">
        <span class="ux-title">Ascent usage</span>
        <span class="ux-tabs"><span class="on">Components</span><span>Props</span><span>Tokens</span></span>
      </div>
      <div class="ux-body">
        <div class="ux-list">
          <span class="ux-search"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>Search components</span>
          {usage.map(([name, count, width], index) => (
            <span class:list={['ux-item', { on: index === 0 }]}>
              <span class="ux-name">{name}</span><span class="ux-count">{count}</span>
              <span class="ux-bar"><span style={`width:${width}%`}></span></span>
            </span>
          ))}
        </div>
        <div class="ux-detail">
          <span class="ux-head">Button</span>
          <span class="ux-sub">2,418 instances · 612 files</span>
          {props.map(([prop, parts]) => (
            <span class="ux-prop">
              <span class="ux-prop-name">{prop}</span>
              <span class="ux-stack">{parts.map(([value, share, color]) => <span style={`flex:${share};background:${color}`}></span>)}</span>
              <span class="ux-legend">{parts.map(([value, share, color]) => <span><i style={`background:${color}`}></i>{value} {share}%</span>)}</span>
            </span>
          ))}
          <span class="ux-prop-name">Tokens</span>
          <span class="ux-tokens">{tokens.map(([color, count]) => <span><i style={`background:${color}`}></i>{count}</span>)}</span>
        </div>
      </div>
    </div>
  </HeroCard>

  <HeroCard label="Standalone package" col={2}>
    <div class="pkg">
      <span class="pkg-src">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
        <span><b>Ascent</b><em>components · tokens · icons</em></span>
      </span>
      <span class="pkg-lines" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="pkg-targets">
        <span>Klaviyo app</span>
        <span>Other applications</span>
        <span class="ai"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>AI design tools</span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="AI design tools" col={2}>
    <div class="ai-row">
      <span class="ai-prompt"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>A card of top flows with a status badge and a view all button</span>
      <span class="ai-out">
        <span class="ai-out-head"><b>Top flows</b><span>View all</span></span>
        <span class="ai-out-row"><span>Abandoned Cart</span><span class="ai-live">Live</span></span>
        <span class="ai-out-row"><span>Welcome Series</span><span class="ai-live">Live</span></span>
      </span>
    </div>
  </HeroCard>
  <HeroCard label="Color" col={2}>
    <Swatches height={32} items={[
      ['var(--color-text-default)', 'Text'], ['var(--color-text-secondary)', 'Secondary'], ['var(--color-text-tertiary)', 'Tertiary'],
      ['var(--color-primary)', 'Primary'], ['var(--color-focus)', 'Focus'],
    ]} />
    <Swatches height={32} items={[
      ['var(--color-background)', 'Background'], ['var(--color-surface-subtle)', 'Subtle'], ['var(--color-surface-muted)', 'Muted'],
      ['var(--color-border)', 'Border'], ['var(--color-brand-poppy)', 'Poppy'],
    ]} />
  </HeroCard>

  <HeroCard label="Button · Select">
    <Row wrap>
      <Button bg="var(--color-text-default)" fg="var(--color-background)" edge="var(--color-text-default)">Create a campaign</Button>
      <Button bg="var(--color-background)" fg="var(--color-text-default)" edge="var(--color-border)">View dashboard</Button>
    </Row>
    <Row wrap align="center">
      <Button bg="var(--color-background)" fg="var(--color-text-default)" edge="var(--color-border)">Placed Order <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-default)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></Button>
    </Row>
  </HeroCard>

  <HeroCard label="Badges · Chips">
    <Row gap={5} wrap>
      <span class="badge" style="background:var(--color-positive-subtle-base);color:var(--color-positive-base)">Live</span>
      <span class="badge" style="background:var(--color-info-subtle-base);color:var(--color-info-base)">Info</span>
      <span class="badge" style="background:var(--color-surface-muted);color:var(--color-text-secondary)">— 0%</span>
    </Row>
    <Row gap={5} wrap>
      <span class="badge suggestion">What should I set up first?</span>
    </Row>
  </HeroCard>

  <HeroCard label="Dashboard card" col={2} row={2}>
    <div class="table-card">
      <span class="table-head">
        <span class="stack">
          <span class="title">Top performing flows</span>
          <span class="dates">Aug 31, 2026 - Sep 30, 2026</span>
        </span>
        <span class="view-all">View all flows</span>
      </span>
      <div class="stack">
        <span class="table-row header">
          <span>Flow</span><span>Status</span><span class="num">Deliveries</span><span class="num">Placed Order</span><span class="num">Change</span>
        </span>
        {flows.map(([flow, trigger], index) => (
          <span class:list={['table-row', { final: index === flows.length - 1 }]}>
            <span class="stack cell">
              <span class="flow">{flow}</span>
              <span class="trigger">{trigger}</span>
            </span>
            <span class="pill live">Live</span>
            <span class="value num">0</span>
            <span class="stack placed">
              <span class="value">0</span>
              <span class="rate">0.00% of recipients</span>
            </span>
            <span class="pill change">— 0.00%</span>
          </span>
        ))}
      </div>
    </div>
  </HeroCard>

  <HeroCard label="Rounded">
    <Shapes size={24} fill="var(--color-surface-subtle)" edge="var(--color-border)" items={[
      { radius: '2px', label: 'xs 2' }, { radius: '8px', label: 'md 8' }, { radius: '16px', label: 'lg 16' },
      { radius: '9999px', label: 'full' }, { radius: '50%', label: 'circle' },
    ]} />
  </HeroCard>

  <HeroCard label="Elevation">
    <Shadows width={26} height={22} radius={8} pad={8} items={[
      ['var(--elevation-shadow-200)', '200'], ['var(--elevation-shadow-300)', '300'],
      ['var(--elevation-shadow-400)', '400'], ['var(--elevation-shadow-600)', '600'],
    ]} />
  </HeroCard>

  <HeroCard label="Motion">
    <Row gap={10} align="center">
      <svg width="56" height="36" viewBox="0 0 56 36" fill="none">
        <path d="M2 34 C 20 34, 2 2, 54 2" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round"/>
        <path d="M2 34H54M2 34V2" stroke="var(--color-border)" stroke-width="1"/>
      </svg>
      <div class="durations">
        <Note>fast 150ms</Note>
        <Note>base 250ms</Note>
        <Note>slow 300ms</Note>
      </div>
    </Row>
  </HeroCard>

  <HeroCard label="Icons">
    <div class="nav-icons">
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M14.05 13.146a.15.15 0 0 0-.15-.15h-3.8a.15.15 0 0 0-.15.15v6.802h4.1zm7.302 5.701a2.7 2.7 0 0 1-2.7 2.701H5.348a2.7 2.7 0 0 1-2.7-2.7v-8.553a2.7 2.7 0 0 1 .953-2.06l6.652-5.701.004-.004a2.7 2.7 0 0 1 3.298-.146l.188.146.004.004 6.652 5.701a2.7 2.7 0 0 1 .953 2.06zm-5.7 1.101h3a1.1 1.1 0 0 0 1.1-1.1v-8.553a1.1 1.1 0 0 0-.39-.841l-.004-.004-6.652-5.701a1.1 1.1 0 0 0-1.413-.001L4.642 9.45l-.004.004a1.1 1.1 0 0 0-.391.84v8.553a1.1 1.1 0 0 0 1.1 1.101H8.35v-6.802a1.75 1.75 0 0 1 1.75-1.75H13.9a1.75 1.75 0 0 1 1.751 1.75z"/></svg>Home</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M2.747 5.575C2.1 3.201 4.595 1.195 6.776 2.336l13.68 7.167c2.015 1.056 2.015 3.94 0 4.994l-13.68 7.166C4.595 22.805 2.1 20.8 2.747 18.424L4.5 12zm3.285-1.82c-.942-.494-2.02.373-1.74 1.4L5.94 11.2h5.623a.8.8 0 1 1 0 1.6H5.94L4.29 18.844c-.28 1.027.799 1.894 1.741 1.4l13.682-7.166c.87-.456.87-1.702 0-2.159z"/></svg>Campaigns</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path fill-rule="evenodd" d="M15.03 1.802c.909.092 1.617.86 1.618 1.792v3.602l-.01.184a1.8 1.8 0 0 1-1.608 1.608l-.183.01H12.8v2.205h4.09c.47 0 .892.219 1.182.556.287.333.433.764.433 1.191v2.052h2.202l.184.01c.908.092 1.617.859 1.617 1.792v3.602l-.009.184a1.8 1.8 0 0 1-1.608 1.608l-.184.009h-5.704l-.185-.009a1.8 1.8 0 0 1-1.607-1.608l-.01-.184v-3.602c0-.933.71-1.7 1.617-1.792l.185-.01h1.901V12.95a.24.24 0 0 0-.044-.147H7.14a.24.24 0 0 0-.044.147v2.052h1.902l.184.01c.908.092 1.617.86 1.617 1.792v3.602l-.009.184a1.8 1.8 0 0 1-1.608 1.608l-.184.009H3.294l-.185-.009a1.8 1.8 0 0 1-1.607-1.608l-.01-.184v-3.602c0-.933.71-1.7 1.617-1.792l.185-.01h2.202V12.95c0-.427.145-.858.432-1.191.29-.338.712-.556 1.182-.556h4.09V8.997H9.143l-.185-.009A1.8 1.8 0 0 1 7.351 7.38l-.01-.184V3.594c0-.933.709-1.7 1.617-1.792l.185-.01h5.704zm-.027 14.8a.203.203 0 0 0-.202.202v3.602c0 .111.09.201.202.201h5.704c.111 0 .201-.09.201-.2v-3.603a.2.2 0 0 0-.201-.202zm-11.709 0a.203.203 0 0 0-.202.202v3.602c0 .111.09.201.202.201h5.704c.11 0 .201-.09.201-.2v-3.603c0-.111-.09-.202-.201-.202zm5.849-13.21a.203.203 0 0 0-.203.202v3.602c0 .111.091.201.203.201h5.704c.11 0 .2-.09.2-.2V3.593a.2.2 0 0 0-.2-.202z" clip-rule="evenodd"/></svg>Flows</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path fill-rule="evenodd" d="M7.581 2.183a4.48 4.48 0 0 1 2.764 8.005 6.16 6.16 0 0 1 2.916 3.145c.435-.544.975-1 1.592-1.334a3.524 3.524 0 1 1 4.923-.02 5.21 5.21 0 0 1 2.773 4.608v4.339l-.005.089a.88.88 0 0 1-.781.782l-.09.005-19.19-.001c-.534 0-.973-.406-1.026-.925l-.005-.106v-5.103a6.13 6.13 0 0 1 3.368-5.476 4.48 4.48 0 0 1 2.76-8.009m.232 8.954a5 5 0 0 1-.46 0 4.536 4.536 0 0 0-4.301 4.53v4.534h9.068v-3.614l.001-.045v-.875a4.536 4.536 0 0 0-4.308-4.53m9.771 1.844a3.6 3.6 0 0 1-.53.002 3.615 3.615 0 0 0-3.333 3.604V20.2h7.228v-3.614a3.615 3.615 0 0 0-3.365-3.606m-.28-5.436a1.923 1.923 0 0 0-.22 3.834 5 5 0 0 1 .446-.001 1.923 1.923 0 0 0-.226-3.833M7.58 3.782c-1.59 0-2.88 1.29-2.88 2.881a2.88 2.88 0 0 0 2.724 2.873q.081-.003.162-.004l.152.003a2.878 2.878 0 0 0-.158-5.753" clip-rule="evenodd"/></svg>Audience</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12.994 15.673a.8.8 0 0 1 0 1.6H7.031a.8.8 0 0 1 0-1.6z"/><path fill-rule="evenodd" d="M12.745 6.484c.686 0 1.243.557 1.243 1.243v4.472l-.007.127a1.24 1.24 0 0 1-1.108 1.109l-.128.006H7.28l-.127-.006a1.24 1.24 0 0 1-1.108-1.109l-.007-.127V7.727c0-.686.556-1.243 1.242-1.243zm-5.108 5.357h4.75V8.084h-4.75z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M15.106 2.757a2.87 2.87 0 0 1 2.87 2.87v.235h1.271a2.87 2.87 0 0 1 2.871 2.87v9.645a2.87 2.87 0 0 1-2.87 2.871H4.752a2.87 2.87 0 0 1-2.87-2.871V5.627a2.87 2.87 0 0 1 2.87-2.87zm-10.353 1.6a1.27 1.27 0 0 0-1.27 1.27v12.75c0 .701.568 1.27 1.27 1.27h11.623V5.628a1.27 1.27 0 0 0-1.27-1.27zm13.224 15.29h1.27a1.27 1.27 0 0 0 1.27-1.27V8.732a1.27 1.27 0 0 0-1.27-1.27h-1.27z" clip-rule="evenodd"/></svg>Content</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path fill-rule="evenodd" d="M12 2.083c5.477 0 9.917 4.44 9.917 9.917s-4.44 9.917-9.917 9.917S2.083 17.477 2.083 12 6.523 2.083 12 2.083m-.922 1.651A8.318 8.318 0 0 0 12 20.317a8.317 8.317 0 0 0 8.265-7.391 2 2 0 0 1-.147.008h-7.332a1.716 1.716 0 0 1-1.716-1.716v-7.33q0-.078.008-.154m1.617.083a.1.1 0 0 0-.025.07v7.33a.117.117 0 0 0 .116.117l7.332-.001a.1.1 0 0 0 .07-.025l.004-.007v-.002a8.366 8.366 0 0 0-7.487-7.486h-.003q-.001 0-.007.004" clip-rule="evenodd"/></svg>Analytics</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M19.998 4.668c0-.715-.58-1.295-1.295-1.295H5.296c-.715 0-1.295.58-1.295 1.295v14.664c0 .715.58 1.295 1.295 1.295h13.407c.715 0 1.295-.58 1.295-1.295zm1.6 14.664a2.895 2.895 0 0 1-2.895 2.895H5.296a2.895 2.895 0 0 1-2.895-2.895V4.668a2.895 2.895 0 0 1 2.895-2.895h13.407a2.894 2.894 0 0 1 2.895 2.895z"/><path d="M15.77 11.2a.8.8 0 0 1 0 1.6H8.23a.8.8 0 1 1 0-1.6zM15.77 7.036a.8.8 0 0 1 0 1.6H8.23a.8.8 0 1 1 0-1.6zM15.77 15.364a.8.8 0 0 1 0 1.6H8.23a.8.8 0 1 1 0-1.6z"/></svg>Website</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path fill-rule="evenodd" d="M17.047 1.588a4.405 4.405 0 1 1-3.32 7.296l-2.956 1.72a4.4 4.4 0 0 1-.022 2.853l2.984 1.65a4.405 4.405 0 1 1-.82 1.375l-2.957-1.634-.003-.002a4.4 4.4 0 0 1-3.36 1.56 4.405 4.405 0 1 1 3.403-7.203l2.914-1.695a4.405 4.405 0 0 1 4.137-5.92m0 13.615a2.805 2.805 0 1 0 .001 5.61 2.805 2.805 0 0 0-.001-5.61M6.593 9.195a2.805 2.805 0 1 0 0 5.61 2.805 2.805 0 0 0 0-5.61m10.454-6.007a2.805 2.805 0 1 0 .001 5.61 2.805 2.805 0 0 0-.001-5.61" clip-rule="evenodd"/></svg>Social</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path fill-rule="evenodd" d="M16.35 2.806c.513 0 1.008.165 1.425.463.416.296.738.71.943 1.181l3.152 7.23a.8.8 0 0 1 .066.32v6.297c0 .735-.254 1.46-.732 2.009-.481.552-1.16.89-1.894.89H4.692c-.735 0-1.414-.338-1.895-.89a3.07 3.07 0 0 1-.732-2.01V12a.8.8 0 0 1 .067-.32l3.151-7.23c.205-.472.528-.885.944-1.181a2.46 2.46 0 0 1 1.424-.463zM3.665 18.296c0 .378.132.721.339.959.204.234.455.34.688.34H19.31c.233 0 .484-.106.688-.34.207-.238.338-.581.338-.958v-5.25h-4.278l-1.587 2.145a.8.8 0 0 1-.643.325h-3.654a.8.8 0 0 1-.644-.325l-1.587-2.145H3.665zm3.987-13.89a.86.86 0 0 0-.498.166c-.16.115-.305.29-.403.516l-.001.002-2.771 6.357h4.368l.093.005a.8.8 0 0 1 .55.32l1.586 2.144h2.849l1.587-2.145a.8.8 0 0 1 .643-.324h4.368L17.251 5.09l-.001-.002a1.23 1.23 0 0 0-.403-.516.86.86 0 0 0-.498-.167z" clip-rule="evenodd"/></svg>Service</span>
      <span><svg viewBox="0 0 24 24" width="18" height="18"><path d="M9.26 4.235a.17.17 0 0 0-.171-.17H4.235a.17.17 0 0 0-.17.17V9.09c0 .094.076.17.17.17H9.09c.094 0 .17-.076.17-.17zm1.6 4.854a1.77 1.77 0 0 1-1.771 1.77H4.235a1.77 1.77 0 0 1-1.77-1.77V4.235c0-.978.792-1.77 1.77-1.77H9.09c.978 0 1.77.792 1.77 1.77zM19.937 4.235a.17.17 0 0 0-.17-.17h-4.854a.17.17 0 0 0-.171.17V9.09c0 .094.076.17.17.17h4.854c.095 0 .171-.076.171-.17zm1.6 4.854a1.77 1.77 0 0 1-1.77 1.77h-4.854a1.77 1.77 0 0 1-1.77-1.77V4.235c0-.978.792-1.77 1.77-1.77h4.853c.978 0 1.77.792 1.77 1.77zM9.26 14.913a.17.17 0 0 0-.171-.17H4.235a.17.17 0 0 0-.17.17v4.854c0 .094.076.17.17.17H9.09c.094 0 .17-.076.17-.17zm1.6 4.854a1.77 1.77 0 0 1-1.771 1.77H4.235a1.77 1.77 0 0 1-1.77-1.77v-4.854c0-.978.792-1.77 1.77-1.77H9.09c.978 0 1.77.792 1.77 1.77zM16.5 20.796V18.1h-2.694a.8.8 0 0 1 0-1.6H16.5v-2.695a.8.8 0 0 1 1.601 0v2.695h2.694a.8.8 0 0 1 0 1.6h-2.694v2.695a.8.8 0 0 1-1.6 0"/></svg>Integrations</span>
    </div>
  </HeroCard>

</div>

<style>
  .ascent {
    display: contents;
    --font-family-base: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --color-text-default: #1D1E20; --color-text-secondary: #4B4D4E; --color-text-tertiary: #747576;
    --color-primary: #155FEA; --color-focus: #397EE5; --color-brand-poppy: #F96353;
    --color-background: #FFFFFF; --color-surface-subtle: #F3F6F7; --color-surface-muted: #EAEDEF; --color-border: #C4C9CF;
    --color-icon-nav: #5D5E60;
    --color-positive-subtle-base: #DAFBE4; --color-positive-base: #25935C; --color-positive-text: #228654;
    --color-attention-subtle-base: #FFE7C0; --color-attention-base: #F36F09; --color-attention-text: #561D03;
    --color-negative-subtle-base: #FDCDC9; --color-negative-base: #DF3535; --color-negative-text: #C72326;
    --color-info-subtle-base: #E0F2FF; --color-info-base: #397EE5; --color-info-text: #155FEA;
    --color-intelligence-subtle-base: #C2C2FF; --color-intelligence-base: #737DFE; --color-intelligence-text: #372AAC;
    --elevation-shadow-200: rgba(55,63,71,.08) 0 2px 8px, rgba(55,63,71,.12) 0 1px 2px;
    --elevation-shadow-300: rgba(55,63,71,.04) 0 0 0 1px, rgba(55,63,71,.08) 0 4px 4px, rgba(55,63,71,.08) 0 8px 24px;
    --elevation-shadow-400: rgba(55,63,71,.15) 0 0 0 1px, rgba(55,63,71,.15) 0 8px 16px;
    --elevation-shadow-600: rgba(55,63,71,.08) 0 0 0 2px, rgba(55,63,71,.12) 0 8px 20px, rgba(55,63,71,.12) 0 16px 32px;

