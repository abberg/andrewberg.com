---
import HeroCard from '../parts/HeroCard.astro';
import Note from '../parts/Note.astro';
import Row from '../parts/Row.astro';
import Swatches from '../parts/Swatches.astro';
import Chips from '../parts/Chips.astro';
import Bars from '../parts/Bars.astro';
import Shapes from '../parts/Shapes.astro';
import Shadows from '../parts/Shadows.astro';
import Button from '../parts/Button.astro';
import Control from '../parts/Control.astro';
import Field from '../parts/Field.astro';
import Banner from '../parts/Banner.astro';
import ComponentList from '../parts/ComponentList.astro';
import OutlineIcons from '../parts/OutlineIcons.astro';

// WPDS, The Washington Post. Postoni headlines, Georgia body, Franklin for everything else.
const sizes = ['075', '087', '100', '112', '125', '150', '175', '200', '225', '250', '275', '300', '350', '400', '450', '500'];
const weights = [['light', 300], ['regular', 400], ['bold', 700], ['ultra', 800]];
const grays = ['#000000', '#111111', '#2A2A2A', '#494949', '#595959', '#737373', '#AAAAAA', '#D4D4D4', '#E9E9E9', '#F0F0F0', '#F7F7F7', '#FFFFFF'];
const blues = ['#0A3258', '#0F4B84', '#1366B3', '#166DFC', '#5784C5', '#84A4D6', '#ACC5E7', '#D3E7FA', '#E7F0FE'];
const stories = [
  ['The glaciers that feed a continent are thinning fast'],
  ['A heat map of every U.S. county this summer'],
  ['Inside the race to rebuild a coral reef'],
  ['What rising seas mean for your street'],
];
const components = [
  'Accordion', 'Action Menu', 'Alert Banner', 'App bar', 'Avatar', 'Box', 'Button', 'Card', 'Carousel', 'Checkbox', 'Container',
  'Dialog', 'Divider', 'Drawer', 'Icon', 'Input Password', 'Input Search', 'Input Text', 'Input Text Area', 'Navigation Menu',
  'Pagination Dots', 'Popover', 'Radio Group', 'Select', 'Switch', 'Tabs', 'Tooltip', 'Visually Hidden',
];
---
<div class="wpds">
  <HeroCard label="Typography" col={2} row={2}>
    <div class="ty">
      <span class="ty-row"><Note>headline</Note><span class="ty-headline">Democracy Dies in Darkness</span></span>
      <span class="ty-row"><Note>magazine</Note><span class="ty-magazine">The Week That Shook the Capital</span></span>
      <span class="ty-row"><Note>subhead</Note><span class="ty-subhead">What to know about early voting this year</span></span>
      <span class="ty-row"><Note>body</Note><span class="ty-body">Polls close at 8 p.m. Eastern, with first results within the hour.</span></span>
      <span class="ty-row"><Note>meta</Note><span class="ty-meta">By Andrew Berg · Updated Oct. 4 at 9:15 a.m.</span></span>
      <span class="ty-foot">
        <span class="ty-weights">{weights.map(([name, weight]) => <span class="ty-w"><span style={`font-weight:${weight}`}>Aa</span><Note>{`${name} ${weight}`}</Note></span>)}</span>
        <span class="ty-sizes">{sizes.map(size => <span style={`font-size:${Math.round(+size / 100 * 16 * .4 * 10) / 10}px`}>A</span>)}</span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="Light and dark" col={2} row={2}>
    <div class="dm">
      <span class="dm-pane light">
        <span class="dm-top"><span class="dm-sec">Politics</span><span class="dm-toggle"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span></span>
        <span class="dm-img"></span>
        <span class="dm-head">How the vote count unfolds overnight</span>
        <span class="dm-deck">Counties report at different speeds, so early leads can flip as mail ballots are counted.</span>
        <span class="dm-by">By Andrew Berg · 4 min read</span>
        <span class="dm-actions"><span class="dm-btn solid">Subscribe</span><span class="dm-btn outline-btn">Share</span></span>
      </span>
      <span class="dm-pane dark">
        <span class="dm-top"><span class="dm-sec">Politics</span><span class="dm-toggle"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></svg></span></span>
        <span class="dm-img"></span>
        <span class="dm-head">How the vote count unfolds overnight</span>
        <span class="dm-deck">Counties report at different speeds, so early leads can flip as mail ballots are counted.</span>
        <span class="dm-by">By Andrew Berg · 4 min read</span>
        <span class="dm-actions"><span class="dm-btn solid">Subscribe</span><span class="dm-btn outline-btn">Share</span></span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="Carousel" col={2}>
    <div class="car">
      <span class="car-top"><span class="car-title">More from Climate</span><span class="car-nav"><span class="car-arrow"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span><span class="car-arrow"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></span></span>
      <span class="car-track">{stories.map(([headline]) => <span class="car-item"><span class="car-img"></span><span class="car-head">{headline}</span></span>)}</span>
      <span class="car-dots"><span class="on"></span><span></span><span></span><span></span></span>
    </div>
  </HeroCard>

  <HeroCard label="Button" col={2}>
    <div class="matrix">
      <span class="w-btn primary"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Follow</span><span class="w-btn primary outline">Follow</span><span class="w-btn primary compact"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Follow</span><span class="w-btn primary icon"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span><span class="w-btn primary icon compact"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span><span class="w-btn primary off">Follow</span>
      <span class="w-btn secondary"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M7 8l5-5 5 5"/></svg>Share</span><span class="w-btn secondary outline">Share</span><span class="w-btn secondary compact"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M7 8l5-5 5 5"/></svg>Share</span><span class="w-btn secondary icon"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M7 8l5-5 5 5"/></svg></span><span class="w-btn secondary icon compact"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M12 3v12M7 8l5-5 5 5"/></svg></span><span class="w-btn secondary off">Share</span>
      <span class="w-btn cta">Subscribe<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><span class="w-btn cta outline">Subscribe</span><span class="w-btn cta compact">Subscribe<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><span class="w-btn cta icon"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><span class="w-btn cta icon compact"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><span class="w-btn cta off">Subscribe</span>
    </div>
  </HeroCard>

  <HeroCard label="Color" col={2}>
    <Chips cols={12} gap={4} edge="var(--gray-80)" colors={grays} />
    <Swatches cols={5} gap={6} items={[
      ['var(--cta)', 'CTA'], ['var(--error)', 'Error'], ['var(--success)', 'Success'], ['var(--warning)', 'Warning'], ['var(--signal)', 'Signal'],
    ]} />
  </HeroCard>

  <HeroCard label="Input Search">
    <div class="search">
      <span class="search-input"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>elec<span class="caret"></span></span>
      <span class="search-list">
        <span class="on"><b>Elec</b>tion results</span><span><b>Elec</b>tric vehicles</span><span><b>Elec</b>toral college</span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="Alert Banner">
    <Banner dot tint="#E7F0FE" accent="var(--signal)">Renews Friday.</Banner>
    <Banner dot tint="#EEF9EA" accent="var(--success)">Saved to your list.</Banner>
    <Banner dot tint="#FFEFE0" accent="var(--warning)">2 free articles left.</Banner>
    <Banner dot tint="#FDE7E7" accent="var(--error)">Card declined.</Banner>
  </HeroCard>

</div>

<style>
  .wpds {
    display: contents;
    --font-headline: 'Bodoni Moda', Postoni, garamond, serif;
    --font-body: georgia, 'Times New Roman', serif;
    --font-meta: 'Libre Franklin', Franklin, arial, sans-serif;
    --font-magazine: 'Bodoni Moda', PostoniDisplayMag, garamond, serif;
    --primary: #111111; --onPrimary: #FFFFFF; --cta: #166DFC;
    --error: #D35F4F; --success: #499327; --warning: #E6823D; --signal: #5784C5;
    --gray-40: #595959; --gray-60: #737373; --gray-70: #D4D4D4; --gray-80: #E9E9E9; --gray-90: #F0F0F0;

    --hero-font: var(--font-meta); --hero-display-font: var(--font-headline); --hero-display-weight: 700;
    --hero-ink: var(--primary); --hero-note: var(--gray-60);
    --button-pad: 8px; --button-radius: 4px; --button-weight: 700; --button-size: 9px;
    --field-gap: 2px; --field-height: 22px; --field-radius: 4px; --field-edge: var(--gray-70);
    --field-label-size: 8px; --field-label-weight: 400; --field-label-color: var(--gray-60);
    --banner-pad: 3px 8px;
  }
  .headline { font-family: var(--font-headline); font-weight: 700; font-size: 16px; line-height: 1.15; color: var(--primary); }
  .body-copy { font-family: var(--font-body); font-size: 11px; line-height: 1.5; color: var(--primary); }
  .meta-copy { font-family: var(--font-meta); font-size: 10px; color: var(--gray-40); }


  .matrix span, .search span { font-family: var(--font-meta); }
  .w-btn { display: inline-flex; align-items: center; justify-content: center; gap: 4px; height: 24px; padding: 0 10px; border-radius: 9999px; font-size: 9px; font-weight: 700; white-space: nowrap; }
  .w-btn.primary { background: var(--primary); color: #fff; }
  .w-btn.secondary { background: #fff; color: var(--primary); box-shadow: inset 0 0 0 1px var(--gray-70); }
  .w-btn.cta { background: var(--cta); color: #fff; }
  .w-btn.outline { background: #fff; box-shadow: inset 0 0 0 1px currentColor; }
  .w-btn.primary.outline, .w-btn.secondary.outline { color: var(--primary); }
  .w-btn.cta.outline { color: var(--cta); }
  .w-btn.off { background: var(--gray-80); color: var(--gray-60); box-shadow: none; }
  .w-btn.compact { height: 20px; padding: 0 8px; font-size: 8px; }
  .w-btn.icon { width: 24px; padding: 0; }
  .w-btn.icon.compact { width: 20px; }
  .matrix { flex: 1; display: grid; grid-template-columns: repeat(6, auto); justify-content: space-between; align-content: center; align-items: center; justify-items: start; gap: 7px 6px; }

  .search { flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .search-input { display: flex; align-items: center; gap: 6px; height: 24px; padding: 0 9px; border-radius: 4px; box-shadow: inset 0 0 0 1px var(--primary); font-size: 10px; color: var(--primary); }
  .caret { width: 1px; height: 11px; background: var(--primary); margin-left: -5px; }
  .search-list { display: flex; flex-direction: column; padding: 3px 0; border-radius: 4px; background: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.15), inset 0 0 0 1px var(--gray-80); }
  .search-list span { padding: 3px 10px; font-size: 9px; color: var(--gray-40); }
  .search-list b { color: var(--primary); }
  .search-list .on { background: var(--gray-90); }

  .car { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; overflow: hidden; }
  .car span, .dm span { font-family: var(--font-meta); }
  .car-top { display: flex; justify-content: space-between; align-items: center; }
  .car-title { font-size: 11px; font-weight: 700; color: var(--primary); }
  .car-nav { display: flex; gap: 4px; }
  .car-arrow { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--gray-70); color: var(--primary); }
  .car-track { display: flex; gap: 8px; margin-right: -40px; }
  .car-item { flex: none; display: flex; flex-direction: column; gap: 4px; width: 92px; }
  .car-img { height: 38px; border-radius: 2px; background: var(--gray-80); }
  .car-head { font-family: var(--font-headline) !important; font-size: 8.5px; font-weight: 700; line-height: 1.2; color: var(--primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .car-dots { display: flex; justify-content: center; gap: 4px; }
  .car-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--gray-70); }
  .car-dots .on { background: var(--primary); }

  .dm { flex: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-radius: 6px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--gray-80); }
  .dm-pane { --ink: #111111; --sub: #595959; --rule: #E9E9E9; --img: #E9E9E9; --bg: #FFFFFF; display: flex; flex-direction: column; gap: 7px; padding: 12px 14px; background: var(--bg); }
  .dm-pane.dark { --ink: #FFFFFF; --sub: #A1A1A1; --rule: #333333; --img: #333333; --bg: #141414; }
  .dm-top { display: flex; justify-content: space-between; align-items: center; padding-bottom: 5px; border-bottom: 1px solid var(--rule); }
  .dm-sec { font-size: 8.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink); }
  .dm-toggle { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--rule); color: var(--ink); }
  .dm-head { font-family: var(--font-headline) !important; font-size: 15px; font-weight: 700; line-height: 1.15; color: var(--ink); }
  .dm-img { height: 64px; border-radius: 2px; background: var(--img); }
  .dm-deck { font-family: var(--font-body) !important; font-size: 9px; line-height: 1.5; color: var(--sub); }
  .dm-by { font-size: 8px; color: var(--sub); }
  .dm-actions { display: flex; gap: 4px; margin-top: auto; }
  .dm-btn { flex: none; display: inline-flex; align-items: center; height: 20px; padding: 0 9px; border-radius: 9999px; font-size: 8.5px; font-weight: 700; }
  .dm-btn.solid { background: var(--ink); color: var(--bg); }
  .dm-btn.outline-btn { color: var(--ink); box-shadow: inset 0 0 0 1px var(--rule); }

  .ty { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 8px; min-height: 0; }
  .ty span { font-family: var(--font-meta); }
  .ty-row { display: grid; grid-template-columns: 46px minmax(0, 1fr); align-items: baseline; gap: 8px; }
  .ty .ty-headline { font-family: var(--font-headline); font-weight: 700; font-size: 24px; line-height: 1.1; color: var(--primary); }
  .ty .ty-magazine { font-family: var(--font-magazine); font-variation-settings: 'opsz' 96; font-weight: 900; font-size: 22px; line-height: 1.1; color: var(--primary); }
  .ty .ty-subhead { font-weight: 700; font-size: 14px; line-height: 1.25; color: var(--primary); }
  .ty .ty-body { font-family: var(--font-body); font-size: 11px; line-height: 1.6; color: var(--primary); }
  .ty .ty-meta { font-weight: 300; font-size: 10px; line-height: 1.25; color: var(--gray-40); }
  .ty-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; padding-top: 10px; border-top: 1px solid var(--gray-80); }
  .ty-weights { display: flex; gap: 10px; }
  .ty-w { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; }
  .ty-w > span:first-child { font-size: 22px; line-height: 1; color: var(--primary); }
  .ty-sizes { display: flex; align-items: baseline; gap: 2px; }
  .ty-sizes span { font-weight: 700; line-height: .8; color: var(--primary); }
</style>
