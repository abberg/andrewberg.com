---
import Note from './Note.astro';
// Labelled colour swatches, in a flex row or, with `cols`, a grid.
const { items, height = 16, gap = 5, cols } = Astro.props;
const px = v => typeof v === 'number' ? `${v}px` : v;
---
<div class="swatches" style={{ display: cols ? 'grid' : 'flex', gridTemplateColumns: cols && `repeat(${cols},minmax(0,1fr))`, gap: px(gap) }}>
  {items.map(([color, label]) => (
    <span class="swatch">
      <span class="chip" style={{ height: `${height}px`, background: color }}></span>
      <Note>{label}</Note>
    </span>
  ))}
</div>
<style>
  .swatch { display: flex; flex-direction: column; gap: 3px; flex: 1; }
  .chip { border-radius: var(--hero-swatch-radius, 4px); box-shadow: inset 0 0 0 1px var(--hero-edge, transparent); }
</style>
