---
import Note from './Note.astro';
// A labelled text input drawn with the system's --field-* tokens.
const { label, value, hint } = Astro.props;
---
<span class="field">
  <span class="label">{label}</span>
  <span class="input">{value}</span>
  {hint && <Note>{hint}</Note>}
</span>
<style>
  .field { display: flex; flex-direction: column; gap: var(--field-gap, 3px); }
  .label { font-family: var(--hero-font); font-size: var(--field-label-size, 9px); font-weight: var(--field-label-weight, 600); color: var(--field-label-color, var(--hero-ink)); }
  .input {
    display: flex; align-items: center; height: var(--field-height, 24px); padding: 0 8px;
    border-radius: var(--field-radius); box-shadow: inset 0 0 0 1px var(--field-edge);
    font-family: var(--hero-font); font-size: 9px; color: var(--hero-ink);
  }
</style>
