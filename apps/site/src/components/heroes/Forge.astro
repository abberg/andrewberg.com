  ["Diagnosis Problems", "<svg width=\"22\" height=\"22\" aria-hidden=\"true\" viewBox=\"0 0 25 25\"><g><g class=\"fe_c_icon__background\"><rect width=\"25\" height=\"25\"></rect></g><g class=\"fe_c_icon__icon fe_c_icon__icon--primary\"><g><path d=\"M16.7,3.4V2.8A1.8,1.8,0,0,0,14.9,1H10.1A1.8,1.8,0,0,0,8.3,2.8v.6H2.8V19.5H18.9a3.3,3.3,0,0,0,3.3-3.3V3.4ZM9.8,2.8a.3.3,0,0,1,.3-.3h4.8a.3.3,0,0,1,.3.3v.6H9.8ZM20.7,16.2A1.8,1.8,0,0,1,18.9,18H4.3V4.9H20.7Z\"></path><polygon points=\"11.8 15.4 13.3 15.4 13.3 12.2 16.4 12.2 16.4 10.7 13.3 10.7 13.3 7.6 11.8 7.6 11.8 10.7 8.6 10.7 8.6 12.2 11.8 12.2 11.8 15.4\"></polygon></g></g></g></svg>"],
];
const styles = [
  ['Page Heading', 34, 25, 600, 'Primary page title'],
  ['Section Heading', 24, 18, 600, 'Major section divisions'],
  ['Sub-section Heading', 18, 14, 600, 'Content subsections'],
  ['Body', 16, 12, 400, 'Primary content text'],
  ['Small text', 14, 10.5, 400, 'Secondary information'],
  ['Tiny text', 12, 9, 400, 'Granular detail copy'],
];
const fweights = [['Light', 300], ['Regular', 400], ['Semibold', 600], ['Bold', 700]];
const schedule = [
  ['8:30', 'Alvarez, Maria', 'Dr. Chen', 'Checked in', 'var(--color-alert-success)', '#FFFFFF'],
  ['9:00', 'Okafor, James', 'Dr. Chen', 'Arrived', 'var(--color-interaction-default)', '#FFFFFF'],
  ['9:15', 'Nguyen, Linh', 'Dr. Patel', 'Scheduled', 'var(--gray-88)', 'var(--gray-20)'],
];
---
<div class="forge">
  <HeroCard label="Form" col={2} row={2} phone>
    <div class="ff">
      <span class="ff-row">
        <span class="ff-label">Name</span>
        <span class="ff-name">
          <span class="ff-col"><span class="ff-top">First name - Required</span><span class="ff-in req focus">Andrew<i class="ff-caret"></i></span></span>
          <span class="ff-col mi"><span class="ff-top">MI</span><span class="ff-in"></span></span>
          <span class="ff-col"><span class="ff-top">Last name - Required</span><span class="ff-in req">Berg</span></span>
        </span>
      </span>
      <span class="ff-row">
        <span class="ff-label">Date of birth - Required</span>
        <span class="ff-col"><span class="ff-in req dob"><span class="ff-ph">MM-DD-YYYY</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span><span class="ff-hint">Only days in the past are available</span></span>
      </span>
      <span class="ff-row">
        <span class="ff-label">Email - Required</span>
        <span class="ff-in req hover email">andrew@example.com</span>
      </span>
      <span class="ff-row">
        <span class="ff-label">Preferred contact method - Required</span>
        <span class="ff-err">
          <span class="ff-group">{['Phone', 'Email', 'Other'].map(o => <span class="ff-opt"><i class="radio"></i>{o}</span>)}</span>
          <span class="ff-alert"><b>!</b>You have not entered a preferred contact method</span>
        </span>
      </span>
      <span class="ff-row">
        <span class="ff-label">Reason for visit - Required</span>
        <span class="ff-in req select">Well visit<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg></span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="Patient schedule" col={2}>
    <div class="ps">
      <span class="ps-row ps-head"><span>Time</span><span>Patient</span><span>Provider</span><span>Status</span></span>
      {schedule.map(([time, name, provider, status, bg, fg]) => (
        <span class="ps-row"><span>{time}</span><span class="ps-name">{name}</span><span>{provider}</span><span class="tag" style={{ background: bg, color: fg }}>{status}</span></span>
      ))}
    </div>
  </HeroCard>

<HeroCard label="Typography" col={2} row={2} phone>
    <div class="ft">
      {styles.map(([name, px, size, weight, use]) => (
        <span class="ft-row">
          <span class="ft-name" style={`font-size:${size}px;font-weight:${weight}`}>{name}</span>
          <span class="ft-spec"><b>{px}px</b>{use}</span>
        </span>
      ))}
      <span class="ft-foot">
        <span class="ft-weights">{fweights.map(([name, weight]) => <span class="ft-w"><span style={`font-weight:${weight}`}>Aa</span><Note>{name}</Note></span>)}</span>
        <span class="ft-fallback">
          <span class="ft-fb"><span>Aa</span><Note>Source Sans Pro</Note></span>
          <span class="ft-fb arial"><span>Aa</span><Note>Arial fallback</Note></span>
        </span>
      </span>
    </div>
  </HeroCard>

  <HeroCard label="Color" col={2}>
    <Swatches gap={6} items={[
      ['var(--color-interaction-default)', 'Interaction'], ['var(--color-interaction-select)', 'Selected'],
      ['var(--color-interaction-hover-dark)', 'Hover'], ['var(--color-interaction-hover)', 'Highlight'],
    ]} />
    <Swatches gap={6} items={[
      ['var(--color-brand)', 'Brand'], ['var(--color-alert-success)', 'Success'], ['var(--color-alert-attention)', 'Attention'], ['var(--color-alert-critical)', 'Critical'],
    ]} />
  </HeroCard>

  <HeroCard label="Button" phone>
    <Row wrap>
      <Button bg="var(--color-interaction-default)" fg="#FFFFFF">Save to Chart</Button>
      <Button bg="#FFFFFF" fg="var(--color-interaction-default)" edge="var(--color-interaction-default)">Secondary</Button>
      <Button bg="transparent" fg="var(--color-interaction-default)">Tertiary</Button>
    </Row>
    <Row align="center">
      <Button bg="var(--color-interaction-default)" fg="#FFFFFF" small>Add Medication</Button>
    </Row>
  </HeroCard>

  <HeroCard label="StatusTag and Avatar" phone>
    <Row gap={5} wrap>
      {tags.map(([label, bg, fg]) => <span class="tag" style={{ background: bg, color: fg }}>{label}</span>)}
    </Row>
    <span class="av-row">
      {avatars.map(([initials, bg, size]) => <span class="av" style={`background:${bg};width:${size}px;height:${size}px;font-size:${size * .4}px`}>{initials}</span>)}
    </span>
  </HeroCard>

  <HeroCard label="FormField" phone>
    <Field label="Patient name" value="Berg, Andrew" hint="Last, First" />
    <Row gap={10} align="center">
      <Control type="checkbox" label="Checkbox" color="var(--color-interaction-default)" />
      <Control type="toggle" label="ToggleSwitch" color="var(--color-interaction-default)" width={30} height={16} />
    </Row>
  </HeroCard>

  <HeroCard label="Icons" phone>
    <span class="fi">{icons.map(([name, svg]) => <span class="fi-icon" title={name} set:html={svg} />)}</span>
  </HeroCard>


</div>

<style>
  .forge {
    display: contents;
    --font-family: 'Source Sans 3', 'Source Sans Pro', Arial, sans-serif;
    --gray-20: #333333; --gray-37: #5F5F5F; --gray-70: #B3B3B3; --gray-88: #E1E1E1;
    --color-interaction-default: #0466B4; --color-interaction-select: #043961; --color-interaction-hover-dark: #005496; --color-interaction-hover: #D9EBFA;
    --color-brand: #614476; --color-brand-dark: #43364D; --color-brand-light: #7E589B;
    --color-alert-success: #118647; --color-alert-attention: #FFAB00; --color-alert-critical: #CA0D0D;

    --hero-font: var(--font-family); --hero-ink: var(--gray-20); --hero-note: var(--gray-37);
    --hero-display-weight: 600; --hero-type-leading: 1.1;
    --hero-edge: rgba(0,0,0,.08); --hero-swatch-radius: 3px;
    --button-pad: 10px; --button-radius: 3px; --button-weight: 600;
    --field-gap: 2px; --field-radius: 3px; --field-edge: var(--gray-70);
    --control-radius: 2px;
  }
  .tag { display: inline-flex; align-items: center; height: 16px; padding: 0 6px; border-radius: 2px; font-family: var(--font-family); font-weight: 600; font-size: 8px; letter-spacing: .06em; text-transform: uppercase; }


  .av-row { display: flex; align-items: center; gap: 6px; margin-top: auto; }
  .av { display: grid; place-items: center; border-radius: 50%; font-family: var(--font-family); font-weight: 600; color: #fff; }
  .fi { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 8px; justify-items: center; color: var(--color-interaction-default); }
  .fi-icon { display: flex; }
  .fi :global(.fe_c_icon__background) { fill: none; }
  .fi :global(.fe_c_icon__icon) { fill: currentColor; }
  .ps { display: flex; flex-direction: column; }
  .ps span { font-family: var(--font-family); }
  .ps-row { display: grid; grid-template-columns: 30px minmax(0, 1.3fr) .9fr 74px; align-items: center; gap: 6px; padding: 5px 4px; border-top: 1px solid var(--gray-70); font-size: 9px; color: var(--gray-37); }
  .ps-head { border-top: 0; }
  .ps-head + .ps-row { border-top-color: var(--gray-37); }
  .ps-head span { font-size: 8px; font-weight: 600; color: var(--gray-20); }
  .ps-name { color: var(--color-interaction-default); font-weight: 600; }
  .ps .tag { justify-self: start; white-space: nowrap; }



  .ft { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-height: 0; }
  .ft span { font-family: var(--font-family); }
  .ft-row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding-bottom: 4px; border-bottom: 1px solid var(--gray-88); }
  .ft-name { line-height: 1.1; color: var(--gray-20); white-space: nowrap; }
  .ft-spec { display: flex; gap: 6px; font-size: 8px; color: var(--gray-37); white-space: nowrap; }
  .ft-spec b { font-weight: 600; color: var(--gray-20); }
  .ft-foot { display: flex; justify-content: space-between; align-items: flex-end; padding-top: 4px; }
  .ft-weights, .ft-fallback { display: flex; gap: 12px; }
  .ft-w, .ft-fb { display: flex; flex-direction: column; gap: 1px; }
  .ft-w > span:first-child, .ft-fb > span:first-child { font-size: 22px; line-height: 1; color: var(--gray-20); }
  .ft-fb > span:first-child { font-weight: 600; }
  .ft-fb.arial > span:first-child { font-family: Arial, 'Liberation Sans', sans-serif; }
  .ff { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-height: 0; }
  .ff span { font-family: var(--font-family); }
  .ff-row { display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: start; gap: 10px; }
  .ff-label { padding-top: 5px; font-size: 11px; line-height: 1.2; color: var(--gray-37); }
  .ff-row:first-child .ff-label { padding-top: 21px; }
  .ff-name { display: flex; gap: 8px; }
  .ff-col { display: flex; flex-direction: column; gap: 3px; }
  .ff-col.mi { width: 32px; }
  .ff-top { font-size: 10.5px; color: var(--gray-37); white-space: nowrap; }
  .ff-in { position: relative; display: flex; align-items: center; justify-content: space-between; height: 26px; width: 116px; padding: 0 8px 0 11px; border-radius: 2px; background: #fff; box-shadow: inset 0 0 0 1px var(--gray-70); font-size: 13px; color: var(--gray-20); white-space: nowrap; }
  .ff-col.mi .ff-in { width: 32px; }
  .ff-in.req { box-shadow: inset 5px 0 0 #2B64AE, inset 0 0 0 1px var(--gray-70); }
  .ff-in.focus { justify-content: flex-start; box-shadow: inset 5px 0 0 #2B64AE, inset 0 0 0 1px #6790C5, 0 0 0 2px #fff, 0 0 0 3px #5683BE; }
  .ff-caret { width: 1px; height: 15px; margin-left: 1px; background: var(--gray-20); }
  .ff-in.hover { box-shadow: inset 5px 0 0 #2B64AE, inset 0 0 0 2px #2B64AE; }
  .ff-in.email { width: 250px; }
  .ff-in.warn { box-shadow: inset 5px 0 0 #F3AF3D, inset 0 0 0 1px #F3AF3D; }
  .ff-in.dob { width: 116px; color: var(--color-interaction-default); }
  .ff-ph { color: #8A8A8A; font-size: 11.5px; }
  .ff-in.select { width: 104px; }
  .ff-in.select svg { color: var(--gray-37); }
  .ff-hint { font-size: 10px; line-height: 1.2; color: var(--gray-37); }
  .ff-err { display: flex; align-items: flex-start; gap: 14px; }
  .ff-alert { display: flex; align-items: center; gap: 7px; padding: 6px 10px 6px 12px; background: #fff; box-shadow: inset 3px 0 0 #F3AF3D, inset 0 0 0 1px #D9D9D9, 0 1px 3px rgba(0,0,0,.08); font-size: 11px; line-height: 1.25; color: var(--gray-20); }
  .ff-err .ff-alert { flex: 1; min-width: 0; max-width: 200px; }
  .ff-alert b { flex: none; display: grid; place-items: center; width: 15px; height: 15px; border-radius: 50%; background: #F3AF3D; font-size: 10px; font-weight: 700; color: var(--gray-20); }
  .ff-group { display: flex; flex-direction: column; gap: 5px; padding-left: 9px; box-shadow: inset 3px 0 0 #F3AF3D; }
  .ff-opt { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--gray-20); white-space: nowrap; }
  .ff-opt i { flex: none; width: 13px; height: 13px; box-shadow: inset 0 0 0 1px #F3AF3D; background: #fff; }
  .ff-opt i.radio { border-radius: 50%; }
  .ff-opt i.box { border-radius: 2px; }
</style>
