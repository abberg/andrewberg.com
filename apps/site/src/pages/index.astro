---
import Base from '../layouts/Base.astro';
import SketchTiles from '../components/SketchTiles.astro';
import sketches from '../data/sketches.json';
import work from '../data/work.json';
import videos from '../data/videos.json';
import HeroStage from '../components/heroes/HeroStage.astro';
import { heroes } from '../components/heroes';
const logos = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const logo = name => logos[`../icons/${name}.svg`];
const systems = [...work].reverse();
// A hand-picked, varied selection for the home page, by sketch number (place in the full list on /sketches/).
const FEATURED = [2, 5, 11, 14, 17, 26, 32, 33];
const featured = FEATURED.map(number => ({ ...sketches[number - 1], number }));
---
<Base
  title="Andrew Berg — Design Systems Engineer"
  description="Andrew Berg is a design systems engineer building accessible React and TypeScript components, reusable patterns, and tools for product teams."
  ogDescription="Design systems engineer building accessible components, patterns, and tools for product teams."
  path="/"
  current="systems"
>
        <section class="intro">
          <div class="mono eyebrow">Intro</div>
          <h1>Ten years, five design systems.</h1>
          <p>I’m a design systems engineer working in React and TypeScript. I work closely with designers to build accessible components, reusable patterns, and the tools and documentation that help product teams use them.</p>
        </section>

        <section id="systems" class="timeline" aria-label="Design systems">
          {systems.map((item, index) => (
            <article class:list={['entry', { last: index === systems.length - 1 }]}>
              <div class="spine" aria-hidden="true"><span class="dot"></span><span class="line"></span></div>
              <div class="body">
                <div class="heading">
                  <p class="mono years">{item.years}</p>
                  <h2>
                    <span class="logo" aria-hidden="true" set:html={logo(item.logo)} />
                    {item.url ? <a href={item.url}>{item.name}</a> : <span>{item.name}</span>}
                  </h2>
                  <p class="meta">{item.company} <span class="role">· {item.role}</span></p>
                </div>
                {(() => { const Hero = heroes[item.logo]; return <HeroStage><Hero /></HeroStage>; })()}
                <div class="blurb">
                  <p><span class="phone-only">{item.role} · </span>{item.summary}</p>
                  {item.url && <a class="mono" href={item.url}>{new URL(item.url).host} ↗</a>}
                </div>
              </div>
            </article>
          ))}
          <div class="end" aria-hidden="true"><span></span></div>
        </section>

        <section id="sketches" class="sketches" aria-labelledby="sketches-heading">
          <div class="sketches-header">
            <div class="mono eyebrow">Before that</div>
            <h2 id="sketches-heading"><span class="mono phone-only">Before that — </span>Browser sketches</h2>
            <a class="mono count" href="/sketches/">All {sketches.length} sketches →</a>
          </div>
          <p class="sketches-intro">My background is in painting and creative technology. These browser sketches explore form, motion, and interaction.</p>
          <SketchTiles items={featured} numbered={false} />
          <p class="more"><a class="mono" href="/sketches/">See all {sketches.length} sketches and {videos.length} recorded ones →</a></p>
        </section>
</Base>
