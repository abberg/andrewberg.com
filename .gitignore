.DS_Store
node_modules/
**/dist/
**/.astro/
apps/site/public/sketches/
apps/site/src/data/sketches.json
output/
.playwright-cli/
tmp/

# Bootleg Toys models are local only.
packages/bootleg-toys/public/models/*

# Claude's local tooling files.
.claude/
packages/bootleg-toys/src/harness-deps.js

# Bumping Heads survey output, local only.
packages/bumping-heads/survey/

# Reference paper for Active Strokes, local only.
packages/active-strokes/*.pdf

# Blender backup saves.
*.blend1

# Sky Castle Garden: the source audio exports.
packages/sky-castle-garden/public/*.aiff

# Story Cube: the Blender files are rebuilt by gallery.py.
packages/hbo-cube/blender/*.blend

# Jetta Spin: the car model is local only, and the Blender file and renders are rebuilt by render_obj.py.
packages/jetta-spin/blender/model/
packages/jetta-spin/blender/*.blend
packages/jetta-spin/renders/

# Walk: the Blender file and raw export are rebuilt by character.py, and the
# reference photos and scan inputs are local only.
packages/walk/blender/*.blend
packages/walk/blender/build/
packages/walk/blender/reference/
packages/walk/blender/tripo/*.png
